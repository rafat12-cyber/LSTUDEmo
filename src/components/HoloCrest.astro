---
// The LSTU crest in real 3D (three.js): shield with the four quadrants of the logo,
// each symbol a 3D model (atom, sun over an open book, palms by the sea, seedling),
// LSTU at the tip and the Bangla name on the ribbon. Drag, arrow keys or the chips turn it.
// Code: src/three/crest.ts and src/three/models.ts. Falls back to the logo image without WebGL.
import { site } from '../lib/site';
import { url } from '../lib/url';
const symbols = [
  { key: 'atom', label: 'Science', note: 'The atom: physics, chemistry and engineering' },
  { key: 'book', label: 'Knowledge', note: 'The sun rising over an open book: learning lights the way' },
  { key: 'coast', label: 'The Meghna coast', note: 'Palms and sea: our home on the coastal belt' },
  { key: 'seed', label: 'Agriculture', note: 'The seedling: farming, fisheries and growth' },
];
---
<div class="holo" data-bn={site.nameBn} tabindex="0" role="img" aria-label="Interactive 3D model of the LSTU crest: an atom, the sun rising over an open book, palm trees by the sea and a seedling, with LSTU and the university's Bangla name. Drag or use the arrow keys to turn it.">
  <div class="holo-stage">
    <img class="crest-fallback" src={url('/images/logo.png')} alt="" width="300" height="300" />
    <canvas class="crest-canvas" aria-hidden="true"></canvas>
    <div class="holo-base" aria-hidden="true"><span class="beam"></span><span class="pad"></span></div>
  </div>
  <ul class="holo-legend" aria-label="Symbols of the crest">
    {symbols.map((s) => (
      <li><button type="button" data-focus={s.key} title={s.note}><span class={`dot dot-${s.key}`}></span>{s.label}</button></li>
    ))}
  </ul>
  <p class="holo-hint" aria-hidden="true"><span>⟲</span> Drag to turn the crest</p>
</div>
